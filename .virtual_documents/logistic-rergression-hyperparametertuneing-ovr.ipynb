from sklearn.datasets import make_classification
x, y = make_classification(n_samples=10000, n_features=10, n_classes=2, random_state=42)


from sklearn.linear_model import LogisticRegression
#data is already scaled
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(x, y, test_size=0.2, random_state=42)

logreg = LogisticRegression()
logreg.fit(X_train, y_train)
y_pred = logreg.predict(X_test)

#scaler = StandardScaler()
#X_train = scaler.fit_transform(X_train)
#X_test = scaler.transform(X_test)



print((y_test==y_pred).sum(),(y_test!=y_pred).sum())


from sklearn.metrics import accuracy_score, confusion_matrix
print(confusion_matrix(y_test,y_pred))
print(accuracy_score(y_test,y_pred))

# Accuracy: (TP + TN) ÷ (TP + FP + FN + TN) = (80) ÷ (100) = 80%
# Precision: (TP) ÷ (TP + FP) = (32) ÷ (40) = 80%
# Recall: (TP) ÷ (TP + FN) = (32) ÷ (44) = 72.7%
# Specificity: (TN) ÷ (TN + FP) = (48) ÷ (56) = 85.7%
# F1 score: (2TP) ÷ (2TP + FP + FN) = (64) ÷ (84) = 76.2%


# HyperParameter Tuning 
model = LogisticRegression()
param_grid = [
    {
        "penalty": ["l1"],
        "solver": ["liblinear", "saga"],
        "C": [0.01, 0.1, 1, 10]
    },
    {
        "penalty": ["l2"],
        "solver": ["lbfgs", "liblinear", "newton-cg", "newton-cholesky", "sag", "saga"],
        "C": [0.01, 0.1, 1, 10]
    },
    {
        "penalty": ["elasticnet"],
        "solver": ["saga"],
        "C": [0.01, 0.1, 1, 10],
        "l1_ratio": [0.2, 0.5, 0.8]
    },
    {
        "penalty": [None],
        "solver": ["lbfgs", "newton-cg", "newton-cholesky", "sag", "saga"]
    }
]
from sklearn.model_selection import GridSearchCV
from sklearn.model_selection import StratifiedKFold
grid = GridSearchCV(estimator=model,param_grid=param_grid, scoring='accuracy', cv=StratifiedKFold(), n_jobs=-1)
grid.fit(X_train, y_train)


grid.best_params_



